{
  "name": "fianzas",
  "version": "0.1.0",
  "private": true,
  "description": "Fianzas de habitación en Soroban: monorepo (apps y packages TS). Los contratos Rust viven en contracts/ con su propio workspace Cargo.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev:web": "pnpm --filter @fianzas/web dev",
    "dev:backoffice": "pnpm --filter @fianzas/backoffice dev"
  }
}
