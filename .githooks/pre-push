#!/bin/sh
# Bloquea push a main, borrado de ramas remotas y pushes que reescriben historia.
zero=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✖ [harness] No se hace push a main. Abre un PR desde tu rama p<n>/<tarea>." >&2
    status=1
  elif [ "$local_sha" = "$zero" ]; then
    echo "✖ [harness] No se borran ramas remotas desde aquí ($remote_ref). Se borran solas al fusionar el PR." >&2
    status=1
  elif [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "✖ [harness] Este push reescribe la historia de $remote_ref. Usa /sync (merge de main) en vez de rebase o force push." >&2
    status=1
  fi
done
exit $status
