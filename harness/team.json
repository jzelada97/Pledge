{
  "$comment": "Fuente única de verdad del reparto. CODEOWNERS, el guard de Claude Code, el check de commits y la CI leen este archivo. Las áreas se evalúan en orden: la primera que coincide gana. Tras cambiarlo, ejecuta: node scripts/harness/sync-codeowners.mjs",
  "roles": {
    "P1": { "name": "Contrato escrow", "github": "CarlosJX7", "person": "Carlos" },
    "P2": { "name": "DeFi + infra (integrador)", "github": "jzelada97", "person": "Jose Zelada" },
    "P3": { "name": "Onboarding sin cripto", "github": "RicardoMatosR", "person": "Ricardo Matos" },
    "P4": { "name": "UX/UI + pitch", "github": "Diego-Matoss", "person": "Diego Matos Romero" }
  },
  "integrator": "P2",
  "areas": [
    { "id": "escrow", "owner": "P1", "paths": ["contracts/escrow/**"], "scopes": ["escrow"] },
    { "id": "factory", "owner": "P1", "paths": ["contracts/factory/**"], "scopes": ["factory"] },
    { "id": "vault", "owner": "P2", "paths": ["contracts/mock-vault/**", "contracts/yield-adapter/**"], "scopes": ["vault", "adapter"] },
    { "id": "bindings", "owner": "P2", "paths": ["packages/bindings/**"], "scopes": ["bindings"], "generated": true },
    { "id": "scripts", "owner": "P2", "paths": ["scripts/deploy/**", "scripts/e2e/**", "scripts/fund/**", "scripts/bindings.sh", "deployments/**"], "scopes": ["scripts"] },
    { "id": "api", "owner": "P2", "paths": ["apps/api/**", "apps/web/app/api/**"], "scopes": ["api"] },
    { "id": "wallet", "owner": "P3", "paths": ["packages/wallet/**"], "scopes": ["wallet"] },
    { "id": "anchor", "owner": "P3", "paths": ["packages/anchor/**"], "scopes": ["anchor"] },
    { "id": "web", "owner": "P4", "paths": ["apps/web/**"], "scopes": ["web"] },
    { "id": "backoffice", "owner": "P4", "paths": ["apps/backoffice/**"], "scopes": ["backoffice"] },
    { "id": "pitch", "owner": "P4", "paths": ["pitch/**"], "scopes": ["pitch"] },
    { "id": "interfaces", "shared": true, "paths": ["docs/INTERFACES.md", ".kiro/**"], "scopes": ["interfaces"] },
    { "id": "harness", "shared": true, "paths": ["CLAUDE.md", "NOTICE.md", "harness/**", ".claude/**", ".githooks/**", "scripts/harness/**", ".gitignore", ".gitattributes", ".env.example"], "scopes": ["harness"] },
    { "id": "ci", "shared": true, "paths": [".github/**"], "scopes": ["ci"] },
    { "id": "deps", "shared": true, "paths": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "tsconfig.base.json", ".npmrc", ".cargo/**", "**/package.json"], "scopes": ["deps"] },
    { "id": "docs", "owner": "*", "paths": ["docs/**", "README.md"], "scopes": ["docs"] }
  ],
  "commitTypes": ["feat", "fix", "test", "docs", "refactor", "chore", "ci", "perf"],
  "labels": {
    "blocked": "bloqueado",
    "lock": "lock",
    "crossArea": "cross-area",
    "interfaceChange": "cambio-interfaz"
  }
}
