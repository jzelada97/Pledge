# Copia este archivo a .env.local (ignorado por git) y rellena los valores.

# OpenZeppelin Relayer (Channels) en testnet. API key: https://channels.openzeppelin.com/testnet/gen
RELAYER_URL=https://channels.openzeppelin.com/testnet
RELAYER_API_KEY=

# RPC de Soroban en testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Anchor de pruebas (SEP-24)
ANCHOR_HOME_DOMAIN=testanchor.stellar.org

# API (apps/api). Solo servidor: ninguna con NEXT_PUBLIC_.
# Cuenta de solo lectura que origina las simulaciones (por defecto, deployments.readSource).
READ_SOURCE=
# Orígenes de nuestras apps, separados por comas (relay y ramp los exigen).
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Ramp simulado (plan B del anchor): secreto de la cuenta faucet (saldo acotado) e interruptor.
RAMP_FAUCET_SECRET=
RAMP_ENABLED=true
# API keys para integradores, JSON: [{"id","secretSha256","label","landlords":[],"scopes":["read","build","submit"],"rpm":300}]
API_KEYS_JSON=

# Plan A: API con rendimiento de Trustless Work (TrustYield). Solo servidor; la da TW al equipo.
TW_API_KEY=
# Opcional: otra URL base (por defecto la de TrustYield, TW_YIELD_URL de @fianzas/trustless).
TW_API_URL=
# Clave S… de la tesorería (testnet): firma los despliegues de escrows en el servidor (#84, decisión 1).
# Sin ella, POST /fianzas/v1/fianzas devuelve el XDR sin firmar para firmarlo fuera y enviarlo por /submit.
TREASURY_SECRET=
# Qué hay detrás de /fianzas/v1: trustless (plan A, por defecto si hay TW_API_KEY) o factory (plan B).
FIANZAS_BACKEND=
